{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Postgres"
  },
  "Jwt": {
    "Issuer": "zerotrust-sentinel",
    "Audience": "zerotrust-sentinel-dashboard",
    "LifetimeMinutes": 60
  },
  "RateLimit": {
    "LoginPerMinute": 5,
    "ApiPerMinute": 120
  },
  "Detection": {
    "LoginAnomalyThreshold": 0.62,
    "TrafficAnomalyThreshold": 0.72,
    "RetrainIntervalMinutes": 5
  },
  "Demo": {
    "Enabled": false
  }
}
