# Copy to .env and replace every value. Never commit .env.
#
# Generate strong random values, e.g.:
#   openssl rand -base64 48
#   (PowerShell) [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))

POSTGRES_PASSWORD=change-me-postgres-password
JWT_KEY=change-me-to-a-random-secret-of-at-least-32-characters

# Initial accounts, created on first start only. Use 12+ characters.
ADMIN_PASSWORD=change-me-admin-password
ANALYST_PASSWORD=change-me-analyst-password
VIEWER_PASSWORD=change-me-viewer-password

# true = generate simulated users and attacks so the dashboard has data
DEMO_MODE=true
